{
  "name": "uma-tools",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:jp": "cd umalator && node build.mjs",
    "build:global": "cd umalator-global && node build.mjs",
    "build:all": "npm run build:jp && npm run build:global",
    "dev": "cd umalator-global && node build.mjs --serve 3000",
    "dev:jp": "cd umalator && node build.mjs --serve 3000",
    "serve": "npm run build:global && node serve.mjs",
    "dev:v2": "cd umalator-global/v2 && npx vite",
    "build:v2": "cd umalator-global/v2 && npx vite build",
    "preview:v2": "cd umalator-global/v2 && npx vite preview",
    "dev:team-trials": "cd team-trials && node build.mjs --serve",
    "build:team-trials": "cd team-trials && node build.mjs",
    "preview:team-trials": "cd team-trials && npx vite preview",
    "dev:release-timeline": "cd release-timeline && node build.mjs --serve",
    "build:release-timeline": "cd release-timeline && node build.mjs",
    "preview:release-timeline": "cd release-timeline && npx vite preview",
    "dev:mechanics": "cd umalator-global/mechanics-explorer && node build.mjs --serve 3000",
    "build:mechanics": "cd umalator-global/mechanics-explorer && node build.mjs",
    "test:mechanics": "npx ts-node umalator-global/mechanics-explorer/mechanics.test.ts",
    "test:roster": "npx ts-node --transpile-only --compiler-options \"{\\\"moduleResolution\\\":\\\"node\\\",\\\"module\\\":\\\"commonjs\\\"}\" umalator-global/v2/roster/roster.test.ts",
    "typecheck:roster": "bash tools/typecheck-roster.sh"
  },
  "author": "pecan",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^20.19.43",
    "@types/tape": "^5.8.1",
    "commander": "^14.0.3",
    "esbuild": "^0.28.2",
    "tape": "^5.10.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@google/genai": "^2.32.0",
    "@tanstack/react-table": "^8.21.3",
    "d3": "^7.9.2",
    "fast-check": "^4.10.2",
    "immutable": "^5.1.9",
    "lucide-react": "^1.70.0",
    "posthog-js": "^1.447.3",
    "prando": "^6.0.1",
    "preact": "^10.29.8",
    "preact-i18n": "^2.4.0-preactx",
    "ts-node": "^10.9.2",
    "unassert-cli": "github:unassert-js/unassert-cli"
  }
}
